# Abrevia 1 — Environment Configuration

# 1. AI Engine (Google Gemini)
GEMINI_API_KEY=

# 2. Cellular SMS Gateway (httpSMS Physical Android Relay)
HTTPSMS_API_KEY=
HTTPSMS_PHONE_NUMBER=

# 3. Database & Storage (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 4. Payments & Monetization (Stripe)
# Obtain test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Specific Stripe Price IDs or Hosted Payment Link URLs
# If left empty, Abrevia dynamically creates line items on Checkout ($49/mo & $20 credits)
STRIPE_MONTHLY_PRICE_ID=
STRIPE_CREDITS_PRICE_ID=
STRIPE_PAYMENT_LINK_PRO=
