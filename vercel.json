{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/reply",
      "destination": "/reply.html"
    },
    {
      "source": "/state",
      "destination": "/abrevia_project_state.json"
    },
    {
      "source": "/project-state",
      "destination": "/abrevia_project_state.json"
    },
    {
      "source": "/api/ping",
      "destination": "/api/tickets?action=ping"
    },
    {
      "source": "/api/customer-portal",
      "destination": "/api/checkout"
    },
    {
      "source": "/api/purge",
      "destination": "/api/tickets"
    },
    {
      "source": "/api/subscribe-updates",
      "destination": "/api/contacts"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
