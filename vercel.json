{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/api/customer-portal",
      "destination": "/api/checkout"
    },
    {
      "source": "/api/purge",
      "destination": "/api/tickets"
    },
    {
      "source": "/api/reply",
      "destination": "/api/tickets"
    },
    {
      "source": "/api/subscribe-updates",
      "destination": "/api/contacts"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
